  "framework": null,
  "git": { "deploymentEnabled": { "codex/*": false } },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/reports.js": { "maxDuration": 60 }, "api/notifications.js": { "maxDuration": 60 } },
  "headers": [{"source":"/service-worker.js","headers":[{"key":"Cache-Control","value":"no-cache"},{"key":"Service-Worker-Allowed","value":"/"}]},{"source":"/central-bugs-version.json","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Access-Control-Allow-Origin","value":"*"}]},{"source":"/central-bugs.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}],
  "rewrites": [ { "source": "/api/reports/:key", "destination": "/api/reports?key=:key" } ]
}
